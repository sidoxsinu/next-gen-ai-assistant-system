# =================================================================
# NEXT-GEN AI ASSISTANT SYSTEM - ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your values.
# .env is ignored by Git to keep your secrets safe.

# -----------------------------------------------------------------
# 1. AI PROVIDERS CONFIGURATION
# -----------------------------------------------------------------
# Supported Providers: 'gemini' | 'groq' | 'ollama'
DEFAULT_AI_PROVIDER="gemini"

# [Option A] Google Gemini API (Recommended)
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# [Option B] Groq Cloud API (Ultra-fast inference)
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# [Option C] Local Ollama (Completely offline, no API key required)
# Install & run Ollama locally: https://ollama.com
# Example: ollama run llama3.2
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# -----------------------------------------------------------------
# 2. GMAIL SMTP CONFIGURATION (For Session Email Dispatch)
# -----------------------------------------------------------------
# NOTE: Do NOT use your personal Google account password!
# Generate a 16-character dedicated Gmail App Password:
# 1. Go to Google Account -> Security: https://myaccount.google.com/security
# 2. Ensure 2-Step Verification is turned ON.
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Generate a new App Password (e.g., named "NextGenAI") and paste it below.
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# -----------------------------------------------------------------
# 3. APPLICATION HOSTING CONFIGURATION
# -----------------------------------------------------------------
APP_URL="http://localhost:3000"
